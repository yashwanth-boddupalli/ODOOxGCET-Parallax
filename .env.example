# ======================
# StockSense Environment Variables
# ======================
# The frontend reads its variables from frontend/.env (Vite's project root),
# not from this file. See frontend/.env.example.
# NEVER commit a .env file — they are excluded via .gitignore.

# Supabase (optional overrides; defaults live in frontend/src/lib/supabase.js)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Application
VITE_APP_NAME=StockSense
VITE_APP_ENV=development
