# Optional. The app already points at the StockSense Supabase project
# (see src/lib/supabase.js). Copy to frontend/.env only to use a different project.
# Use the PUBLISHABLE (anon) key here — never the secret / service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
